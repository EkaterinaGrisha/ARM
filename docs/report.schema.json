    "Discrepancy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9]*\\.[A-Z][A-Z0-9_]*\\.\\d{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Правило, которое нашло расхождение: B1.NAME.001… С версии 1.2",
          "title": "Rule Id"
        },
        "type": {
          "enum": [
            "missing_drawing",
            "orphan_drawing",
            "name_mismatch",
            "duplicate_designation",
            "revision_mismatch",
            "missing_specification"
          ],
          "title": "Type",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
