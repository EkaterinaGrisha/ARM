          "type": "string"
        },
        "designation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Designation"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "document_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Document Ids",
          "type": "array"
        },
        "tree_node_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tree Node Ids",
          "type": "array"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "message"
      ],
      "title": "Discrepancy",
      "type": "object"
    },
