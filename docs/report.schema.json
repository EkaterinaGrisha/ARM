        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "low_confidence",
                "missing",
                "conflict"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ok — значение принято; low_confidence — проверить по документу; missing — значение не найдено; conflict — источники дают разные значения. С версии 1.2",
          "title": "Status"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
